<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Dolu (silüet) diagonal kapsül (hap): yatay bir "stadium" + ortada ince bir boşluk
         (evenOdd ile açılan yarık) iki yarımı gösteriyor, 45° döndürülmüş. Dolu silüet olduğu
         için hem büyük alarm ikonunda hem de bildirim/status bar'daki minik boyutta net çıkar.
         Renk Icon(tint = ...) / bildirim tint'i tarafından yeniden boyanır. -->
    <group
        android:pivotX="12"
        android:pivotY="12"
        android:rotation="45">
        <path
            android:fillColor="#FFFFFFFF"
            android:fillType="evenOdd"
            android:pathData="M8,8 L16,8 A4,4 0 0 1 16,16 L8,16 A4,4 0 0 1 8,8 Z M11.4,8 L12.6,8 L12.6,16 L11.4,16 Z" />
    </group>
</vector>
